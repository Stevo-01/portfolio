---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import JournalLayout from '../../../layouts/JournalLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Icon from '../../../components/ui/Icon.astro';

import CardGrid from '../../../components/journal/CardGrid.astro';
import EmptyState from '../../../components/journal/EmptyState.astro';

import { CATEGORY_ART } from '../../../components/journal/taxonomy';
import { getSeriesParts } from '../../../lib';

export const getStaticPaths = (async () => {
  const series = await getCollection('series');
  return series.map((entry) => ({
    params: { series: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const art = CATEGORY_ART[entry.data.category];

// Ordered by `part` ascending, never by date. A series is a reading path, and
// part 3 written before part 2 must still come after it. That ordering lives in
// getSeriesParts(); do not re-sort here.
const parts = await getSeriesParts(entry.data.slug);
---

<JournalLayout
  title={`${entry.data.title} | The Engineering Journal`}
  description={entry.data.description}
>
  <header class="hero">
    <Container>
      <p class="crumb">
        <a href="/blog/">Journal</a>
        <span aria-hidden="true">/</span>
        <span>Series</span>
      </p>

      <span class="badge" aria-hidden="true"><Icon name={art.glyph} size={24} /></span>

      <p class="kicker">
        Guided series
        <span aria-hidden="true">·</span>
        {parts.length === 0 ? 'in progress' : `${parts.length} parts`}
      </p>

      <h1>{entry.data.title}</h1>
      <p class="desc">{entry.data.description}</p>

      <p class="filed">
        Filed under
        <a href={`/blog/category/${entry.data.category}/`}>{art.title}</a>
      </p>
    </Container>
  </header>

  <section class="band">
    <Container>
      {
        parts.length > 0 ? (
          <CardGrid posts={parts} showPart />
        ) : (
          /* A series can exist before its first part is written. Saying so is
             better than a blank grid under a confident title. */
          <EmptyState
            title="No parts published yet"
            body={`${entry.data.title} is planned but nothing is filed under it so far.`}
          />
        )
      }
    </Container>
  </section>
</JournalLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
    background:
      radial-gradient(ellipse 62% 70% at 20% 0%, var(--glow-apricot), transparent 70%),
      linear-gradient(180deg, var(--hero-bg), var(--bg));
    border-bottom: 1px solid var(--border);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .crumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .badge {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-top: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    border-radius: var(--radius-card);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: var(--space-3);
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .desc {
    max-width: 64ch;
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: 15.5px;
  }

  .filed {
    margin-top: var(--space-5);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .filed a {
    color: var(--accent);
  }

  .band {
    padding-block: var(--space-8);
  }
</style>
