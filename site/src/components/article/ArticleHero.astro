---
import Avatar from '../ui/Avatar.astro';
import CoverArt from '../journal/CoverArt.astro';
import { CATEGORY_ART } from '../journal/taxonomy';
import { formatDate, isoDate } from '../../lib';
import { profile } from '../../data/profile';
import type { Post } from '../../types/content';
import type { IconName } from '../../types/icons';

interface Props {
  post: Post;
  /** Injected by the remark plugin; arrives via render(), not frontmatter. */
  minutesRead?: number;
  seriesTitle?: string;
}

const { post, minutesRead, seriesTitle } = Astro.props;
const { data } = post;

const art = CATEGORY_ART[data.category];
const glyph = (data.heroGlyph as IconName | undefined) ?? art.glyph;

const initials = profile.name
  .split(' ')
  .map((p) => p[0])
  .join('')
  .slice(0, 2);
---

<header class="hero">
  <p class="crumb">
    <a href="/blog/">Journal</a>
    <span aria-hidden="true">/</span>
    <a href={`/blog/category/${data.category}/`}>{art.title}</a>
  </p>

  {
    seriesTitle && data.part && (
      <p class="series-kicker">
        <a href={`/blog/series/${data.series}/`}>{seriesTitle}</a>
        <span aria-hidden="true">·</span>
        <span>Part {data.part}</span>
      </p>
    )
  }

  <h1>{data.title}</h1>
  <p class="dek">{data.description}</p>

  <div class="byline">
    <Avatar initials={initials} size={38} />
    <div class="who">
      <p class="name">{profile.name}</p>
      <p class="role">{profile.role}</p>
    </div>
    <p class="when">
      <time datetime={isoDate(data.publishDate)}>{formatDate(data.publishDate)}</time>
      {/* Never computed here: the remark plugin derives it from the body at
          build time, so it cannot drift from the text it describes. */}
      {minutesRead !== undefined && (
        <>
          <span aria-hidden="true">·</span>
          <span>{minutesRead} min read</span>
        </>
      )}
    </p>
  </div>

  <CoverArt category={data.category} variant="banner" glyph={glyph} />
</header>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .crumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--accent-strong);
  }

  .series-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .series-kicker a {
    color: inherit;
    text-decoration: none;
  }

  .series-kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  h1 {
    /* ~15ch keeps a long title to two or three lines rather than a wall. */
    max-width: 15ch;
    font-size: var(--text-h1-article);
    letter-spacing: -0.038em;
    line-height: 1.06;
  }

  .dek {
    max-width: 62ch;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }

  /* Between hairline rules: the byline is the boundary between the framing and
     the article proper. */
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding-block: var(--space-4);
    border-block: 1px solid var(--border);
  }

  .who {
    display: grid;
    gap: 1px;
  }

  .name {
    color: var(--text);
    font-size: 14.5px;
    font-weight: 650;
  }

  .role {
    color: var(--soft);
    font-size: 13px;
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  @media (max-width: 900px) {
    .when {
      margin-inline-start: 0;
    }
  }
</style>
