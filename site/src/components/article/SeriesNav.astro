---
import Icon from '../ui/Icon.astro';
import { getAdjacentInSeries } from '../../lib';
import type { Post } from '../../types/content';

interface Props {
  post: Post;
  seriesSlug: string;
  seriesTitle: string;
}

const { post, seriesSlug, seriesTitle } = Astro.props;

const { prev, next } = await getAdjacentInSeries(post);
---

{/*
  Renders only for posts in a series, and only when there is somewhere to go.
  With a two-part series both ends are exposed immediately: part 1 has no prev,
  part 2 has no next. Each side is emitted independently, so a missing one
  leaves nothing rather than an empty bordered box.
*/}
<nav class="series-nav" aria-label="Series navigation">
  <p class="rail">
    <span>Part of</span>
    <a href={`/blog/series/${seriesSlug}/`}>{seriesTitle}</a>
  </p>

  <div class="pair" data-single={!prev || !next ? '' : undefined}>
    {
      prev && (
        <a class="step" href={`/blog/${prev.id}/`} data-dir="prev">
          <span class="dir">
            <Icon name="arrow-left" size={14} />
            <span>Previous, part {prev.data.part}</span>
          </span>
          <span class="title">{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="step" href={`/blog/${next.id}/`} data-dir="next">
          <span class="dir">
            <span>Next, part {next.data.part}</span>
            <Icon name="arrow-right" size={14} />
          </span>
          <span class="title">{next.data.title}</span>
        </a>
      )
    }
  </div>
</nav>

<style>
  .series-nav {
    display: grid;
    gap: var(--space-4);
  }

  .rail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .rail a {
    color: var(--accent);
    text-decoration: none;
  }

  .rail a:hover {
    color: var(--accent-strong);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* One-sided: the single card takes the full width instead of leaving a gap
     where the missing sibling would have been. */
  .pair[data-single] {
    grid-template-columns: minmax(0, 1fr);
  }

  .step {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
    text-decoration: none;
    transition:
      border-color var(--dur-ui) var(--ease),
      box-shadow var(--dur-ui) var(--ease);
  }

  .step:hover {
    border-color: var(--border-strong);
    box-shadow: var(--glow-card-hover);
  }

  .step[data-dir='next'] {
    text-align: end;
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }

  .step[data-dir='next'] .dir {
    justify-content: flex-end;
  }

  .title {
    color: var(--text);
    font-size: 15.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .step:hover .title {
    color: var(--accent-strong);
  }

  @media (max-width: 900px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .step[data-dir='next'],
    .step[data-dir='next'] .dir {
      text-align: start;
      justify-content: flex-start;
    }
  }
</style>
