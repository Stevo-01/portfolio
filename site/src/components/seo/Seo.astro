---
import {
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  THEME_COLOR_DARK,
  THEME_COLOR_LIGHT,
  absoluteUrl,
} from './meta';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, canonical, ogImage, noindex, type = 'website' } = Astro.props;

// Absolute, always. A relative og:image is silently ignored by every social
// scraper, and it looks fine in a browser, so the failure only shows up when
// somebody shares a link.
const image = absoluteUrl(ogImage ?? DEFAULT_OG_IMAGE, Astro.site);
const url = absoluteUrl(canonical, Astro.site);
---

<meta name="description" content={description} />
<link rel="canonical" href={url} />

{/*
  Per-scheme, so mobile browser chrome matches the page. The values are
  duplicated from tokens.css by necessity: a meta tag cannot read a CSS custom
  property, and the browser needs this before any stylesheet is parsed.
*/}
<meta name="theme-color" content={THEME_COLOR_DARK} media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content={THEME_COLOR_LIGHT} media="(prefers-color-scheme: light)" />

{/* noindex but still follow: the page should not be listed, but the links on
    it are worth crawling. */}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_GB" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_NAME}
  href={absoluteUrl('/rss.xml', Astro.site)}
/>
