---
// STUB: owned by slice 01 (layout-chrome).
// Prop signature is the published contract — slice 01 replaces the body and
// must not change this interface.
import { THEME_INIT_SCRIPT } from '../lib';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  wide?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Synchronous and before any stylesheet, or the page flashes light. -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
