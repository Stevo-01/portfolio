---
import Header from '../components/layout/Header.astro';
import Seo from '../components/seo/Seo.astro';
import { THEME_INIT_SCRIPT } from '../lib';
import '../styles/global.css';

/*
  Preloaded font subsets.

  fontsource ships every subset at `font-display: swap`, so without a preload
  the browser paints the fallback, then swaps Geist in and reflows. On a fast
  machine with a warm cache that is invisible; on a cold cache and a slow CPU it
  moved the homepage CLS to 0.093 against a 0.05 budget, and the 78px hero
  headline is most of the shift.

  Only the two latin subsets are preloaded. Preloading all eleven would push
  cyrillic and vietnamese onto the critical path of every page for no benefit,
  which trades one metric for another.

  Imported with `?url` rather than hardcoded, because the emitted filenames are
  content-hashed and change whenever the font package updates.
*/
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  wide?: boolean;
}

const { title, description, ogImage, noindex } = Astro.props;

// `Astro.site` is the placeholder host until D1 is answered and slice 09 sets
// the real one. Falling back here rather than asserting keeps `astro check`
// honest about the fact that it can be undefined.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.invalid')
  .href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Synchronous, inline, and before every stylesheet. Deferred or moved below
      a <link rel="stylesheet"> and the page paints dark-then-light for anyone
      who chose light, on every navigation.

      Copied verbatim from src/lib/theme.ts. Its SHA-256 gets pinned in the CSP
      at step 4.3, so reformatting this even by a space invalidates the pin and
      the browser silently refuses to run it.
    */}
    <script is:inline set:html={THEME_INIT_SCRIPT} />

    {/* crossorigin is required even same-origin: fonts are fetched in CORS
        mode, and a preload without it downloads the file twice. */}
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
    />

    <slot name="head" />
  </head>

  <body>
    {/* First focusable element on the page, before the header. */}
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>

<style>
  main {
    /* Clears the fixed header. Without this the first section sits underneath
       it and the hero looks cropped. */
    padding-top: var(--header-h);
  }
</style>
