---
import BaseLayout from './BaseLayout.astro';
import JournalFooter from '../components/layout/JournalFooter.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  wide?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <slot />
  <JournalFooter slot="footer" />
</BaseLayout>
